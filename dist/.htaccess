# .htaccess — SPA fallback, basic security and caching
# Place this file in `public/` so the postbuild script copies it to `dist/`

# Disable directory listing
Options -Indexes

# SPA rewrite: serve index.html for non-file/non-dir requests
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # If request is for a real file or directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Otherwise rewrite to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Basic security headers (if mod_headers enabled)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Simple caching rules (if mod_expires enabled)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/* "access plus 1 month"
</IfModule>
